{
  "name": "automatiostar-checkout-api",
  "version": "1.0.0",
  "description": "In-memory e-commerce checkout REST API built with Express",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test:discount": "node tests/discount-equivalence.js",
    "test": "mocha --require ./tests/setup.js \"tests/**/*.spec.js\" --timeout 15000 --reporter mochawesome --reporter-options reportDir=reports/mochawesome,reportFilename=discount-tests,html=true,json=true,overwrite=true"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "dotenv": "^18.0.9",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "supertest": "^7.3.1"
  }
}
